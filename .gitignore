# Local environment and credentials
.env
.env.*
.venv/
.codex/
.aws/
.streamlit/secrets.toml

# Python and editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.swp

# Snapshot data and historical experiments stay local
/archive/*
/data/*
!/data/datasets.json

# Publish only the selected 9,210-row model input and its provenance.
!/data/final/
/data/final/*
!/data/final/dataset.csv
!/data/final/metadata.json

# Evidence ledgers contain snapshot-specific source text.
# Keep the corresponding *.example.json templates in Git.
/config/ennxo/corrections.json
/config/ennxo/manual_review.json
/config/mac2hand/manual_reviews.json

# Ship only the verified operational artifact needed by Streamlit deployment.
/models/*
!/models/asking_price_v2/
/models/asking_price_v2/*
!/models/asking_price_v2/model.joblib
!/models/asking_price_v2/metadata.json

# Audited numerical condition claims used to rebuild V2 features after clone.
!/data/final/condition_features.csv
